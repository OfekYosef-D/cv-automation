DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cv_automation?schema=public
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_TENANT_ID=t1
PORT=3001
REDIS_URL=redis://localhost:6379

# WorkOS AuthKit Configuration
# Get these from https://dashboard.workos.com
WORKOS_API_KEY=sk_test_xxxxx
WORKOS_CLIENT_ID=client_xxxxx

# URLs
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Auth cookie (optional)
# COOKIE_SAME_SITE=lax   # lax | strict | none. Default: lax. Use "none" for cross-origin with HTTPS.

# Google OAuth integration for tenant-owned Google Docs access
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional. Defaults to ${API_URL}/integrations/google/connect/callback
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_STATE_SECRET=

# Encryption for stored Google refresh tokens
APP_ENCRYPTION_KEY=

# OpenAI CV placeholder generation
OPENAI_API_KEY=
OPENAI_CV_MODEL=gpt-5-mini

# Live job discovery providers
JSEARCH_API_KEY=
SERPAPI_API_KEY=

# Email alerts for saved-search matches
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
ALERT_FROM_EMAIL=
