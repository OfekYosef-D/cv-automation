{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (NestJS)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@cv/api", "dev"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": { "PORT": "3001" }
    },
    {
      "name": "Web (Next.js)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@cv/web", "dev"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "API e2e",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/apps/api/node_modules/.bin/jest",
      "args": ["--config", "apps/api/test/jest-e2e.json", "--runInBand"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "API + Web",
      "configurations": ["API (NestJS)", "Web (Next.js)"],
      "stopAll": true
    }
  ]
}
