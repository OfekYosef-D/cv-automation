generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ArtefactStatus {
  DRAFT
  APPROVED
  REJECTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SNOOZED
}

enum CvSourceType {
  MANUAL
  GOOGLE_DOCS
}

enum CvTemplateMode {
  PLACEHOLDERS
}

enum CvVersionKind {
  BASE
  GENERATED
}

enum JobAlertChannel {
  EMAIL
}

enum JobAlertStatus {
  PENDING
  SENT
  FAILED
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  cvs              Cv[]
  cvVersions       CvVersion[]
  googleConnection GoogleConnection?
  jobSources       JobSource[]
  jobs             Job[]
  jobMatches       JobMatch[]
  artefacts        AgentArtefact[]
  approvals        Approval[]
  consentLogs      ConsentLog[]
  userProfile      UserProfile?
  jobSearchQueries JobSearchQuery[]
  jobAlertPreference JobAlertPreference?
  jobAlerts        JobAlert[]
}

enum AuthProvider {
  LOCAL
  WORKOS
}

model User {
  id        String       @id @default(cuid())
  tenantId  String
  email     String       @unique
  name      String?
  avatarUrl String?
  provider  AuthProvider @default(LOCAL)
  workosId  String?      @unique
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model Cv {
  id        String   @id @default(cuid())
  tenantId  String
  title     String
  sourceType CvSourceType @default(MANUAL)
  isDefault Boolean @default(false)
  sourceDocumentId String?
  sourceDocumentUrl String?
  sourceDocumentTitle String?
  templateMode CvTemplateMode?
  placeholderSchema Json?
  lastSyncedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  versions  CvVersion[]
}

model GoogleConnection {
  id                      String   @id @default(cuid())
  tenantId                String   @unique
  email                   String
  refreshTokenCiphertext  String
  scopes                  String[]
  accessTokenExpiresAt    DateTime?
  connectedAt             DateTime @default(now())
  revokedAt               DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model CvVersion {
  id        String   @id @default(cuid())
  tenantId  String
  cvId      String
  content   String
  kind      CvVersionKind @default(BASE)
  label     String?
  jobId     String?
  parentVersionId String?
  externalDocumentId String?
  externalDocumentUrl String?
  externalDocumentTitle String?
  metadata  Json?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  cv     Cv     @relation(fields: [cvId], references: [id])
  artefacts AgentArtefact[]
}

model JobSource {
  id          String   @id @default(cuid())
  tenantId    String
  type        String
  name        String
  config      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  jobs   Job[]

  @@unique([tenantId, type, name])
}

model Job {
  id            String   @id @default(cuid())
  tenantId      String
  jobSourceId   String
  externalId    String
  title         String
  description   String
  company       String?
  salary        String?
  tags          String[] @default([])
  metadata      Json?
  location      String?
  url           String
  postedAt      DateTime?
  seenAt        DateTime @default(now())
  updatedAt     DateTime @updatedAt
  contentHash   String

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  source    JobSource @relation(fields: [jobSourceId], references: [id])
  matches   JobMatch[]
  artefacts AgentArtefact[]
  approvals Approval[]
  alerts    JobAlert[]

  @@unique([jobSourceId, externalId])
}

model JobMatch {
  id           String   @id @default(cuid())
  tenantId     String
  jobId        String
  score        Int
  explanation  String
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  job    Job    @relation(fields: [jobId], references: [id])
}

model AgentArtefact {
  id            String        @id @default(cuid())
  tenantId      String
  jobId         String
  cvVersionId   String
  promptVersion String
  model         String
  claimsUsed    Json
  status        ArtefactStatus
  content       String
  createdAt     DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  job       Job       @relation(fields: [jobId], references: [id])
  cvVersion CvVersion @relation(fields: [cvVersionId], references: [id])
}

model Approval {
  id        String         @id @default(cuid())
  tenantId  String
  jobId     String
  status    ApprovalStatus
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  job    Job    @relation(fields: [jobId], references: [id])
}

model ConsentLog {
  id        String   @id @default(cuid())
  tenantId  String
  action    String
  metadata  Json
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model UserProfile {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  desiredRoles   String[]
  seniority      String
  location       String
  mustHaveSkills String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model JobSearchQuery {
  id             String   @id @default(cuid())
  tenantId       String
  provider       String
  query          String
  sourceOrigin   String   @default("all")
  location       String?
  seniority      String?
  includeKeywords String[]
  excludeKeywords String[]
  relatedTitles  Boolean  @default(true)
  postedWithinHours Int?
  maxResultsPerRun Int    @default(25)
  minMatchScore  Int?
  cadenceSeconds Int      @default(60)
  enabled        Boolean  @default(true)
  lastRunAt      DateTime?
  lastCompletedAt DateTime?
  lastNewJobsCount Int    @default(0)
  lastAlertedCount Int    @default(0)
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  alerts JobAlert[]
}

model JobAlertPreference {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  emailEnabled    Boolean  @default(true)
  emailAddress    String?
  immediateAlerts Boolean  @default(true)
  minMatchScore   Int?
  cooldownSeconds Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model JobAlert {
  id               String          @id @default(cuid())
  tenantId         String
  jobId            String
  jobSearchQueryId String
  channel          JobAlertChannel
  dedupeKey        String
  status           JobAlertStatus  @default(PENDING)
  deliveryError    String?
  metadata         Json?
  sentAt           DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  job            Job            @relation(fields: [jobId], references: [id])
  jobSearchQuery JobSearchQuery @relation(fields: [jobSearchQueryId], references: [id])

  @@unique([tenantId, channel, dedupeKey])
}
