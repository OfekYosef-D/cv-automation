generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ArtefactStatus {
  DRAFT
  APPROVED
  REJECTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SNOOZED
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  cvs          Cv[]
  cvVersions   CvVersion[]
  jobSources   JobSource[]
  jobs         Job[]
  jobMatches   JobMatch[]
  artefacts    AgentArtefact[]
  approvals    Approval[]
  consentLogs  ConsentLog[]
  userProfile  UserProfile?
}

model User {
  id        String   @id @default(cuid())
  tenantId  String
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model Cv {
  id        String   @id @default(cuid())
  tenantId  String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  versions  CvVersion[]
}

model CvVersion {
  id        String   @id @default(cuid())
  tenantId  String
  cvId      String
  content   String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  cv     Cv     @relation(fields: [cvId], references: [id])
  artefacts AgentArtefact[]
}

model JobSource {
  id          String   @id @default(cuid())
  tenantId    String
  type        String
  name        String
  config      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  jobs   Job[]
}

model Job {
  id            String   @id @default(cuid())
  tenantId      String
  jobSourceId   String
  externalId    String
  title         String
  description   String
  location      String?
  url           String
  postedAt      DateTime?
  seenAt        DateTime @default(now())
  updatedAt     DateTime @updatedAt
  contentHash   String

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  source    JobSource @relation(fields: [jobSourceId], references: [id])
  matches   JobMatch[]
  artefacts AgentArtefact[]
  approvals Approval[]

  @@unique([jobSourceId, externalId])
}

model JobMatch {
  id           String   @id @default(cuid())
  tenantId     String
  jobId        String
  score        Int
  explanation  String
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  job    Job    @relation(fields: [jobId], references: [id])
}

model AgentArtefact {
  id            String        @id @default(cuid())
  tenantId      String
  jobId         String
  cvVersionId   String
  promptVersion String
  model         String
  claimsUsed    Json
  status        ArtefactStatus
  content       String
  createdAt     DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  job       Job       @relation(fields: [jobId], references: [id])
  cvVersion CvVersion @relation(fields: [cvVersionId], references: [id])
}

model Approval {
  id        String         @id @default(cuid())
  tenantId  String
  jobId     String
  status    ApprovalStatus
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  job    Job    @relation(fields: [jobId], references: [id])
}

model ConsentLog {
  id        String   @id @default(cuid())
  tenantId  String
  action    String
  metadata  Json
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model UserProfile {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  desiredRoles   String[]
  seniority      String
  location       String
  mustHaveSkills String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}
